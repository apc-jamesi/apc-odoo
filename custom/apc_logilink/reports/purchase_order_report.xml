<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Purchase Order Report Template -->
    <template id="report_purchase_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row">
                        <div class="col-12">
                            <!-- Header -->
                            <div style="text-align: center; margin-bottom: 30px;">
                                <h2 style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">PURCHASE ORDER</h2>
                                <p style="font-size: 14px; color: #666;">Asia Pacific College</p>
                            </div>
                            
                            <hr style="border-top: 2px solid #000; margin: 20px 0;"/>
                            
                            <!-- PO Information -->
                            <div style="margin-bottom: 30px;">
                                <table style="width: 100%;">
                                    <tr>
                                        <td style="width: 50%; vertical-align: top;">
                                            <table style="width: 100%;">
                                                <tr>
                                                    <td style="padding: 5px 0; font-weight: bold; width: 150px;">PO Number:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.po_number"/></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-weight: bold;">PO Date:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.po_date"/></td>
                                                </tr>
                                                <tr t-if="o.pr_id">
                                                    <td style="padding: 5px 0; font-weight: bold;">PR Number:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.pr_id.pr_number"/></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-weight: bold;">Status:</td>
                                                    <td style="padding: 5px 0;">
                                                        <t t-set="status_dict" t-value="dict(o._fields['status'].selection)"/>
                                                        <t t-esc="status_dict.get(o.status, o.status)"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td style="width: 50%; vertical-align: top;">
                                            <table style="width: 100%;">
                                                <tr t-if="o.supplier_id">
                                                    <td style="padding: 5px 0; font-weight: bold; width: 150px;">Supplier:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.supplier_id.name"/></td>
                                                </tr>
                                                <tr t-if="o.supplier_id and o.supplier_id.street">
                                                    <td style="padding: 5px 0; font-weight: bold;">Address:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.supplier_id.street"/></td>
                                                </tr>
                                                <tr t-if="o.supplier_id and o.supplier_id.phone">
                                                    <td style="padding: 5px 0; font-weight: bold;">Phone:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.supplier_id.phone"/></td>
                                                </tr>
                                                <tr t-if="o.supplier_id and o.supplier_id.email">
                                                    <td style="padding: 5px 0; font-weight: bold;">Email:</td>
                                                    <td style="padding: 5px 0;"><t t-esc="o.supplier_id.email"/></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            
                            <hr style="border-top: 1px solid #ccc; margin: 20px 0;"/>
                            
                            <!-- PO Lines Table -->
                            <div style="margin-top: 20px;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <thead>
                                        <tr style="background-color: #f0f0f0;">
                                            <th style="border: 1px solid #000; padding: 10px; text-align: left; font-weight: bold;">Item Description</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: center; font-weight: bold;">Quantity</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: right; font-weight: bold;">Unit Price</th>
                                            <th style="border: 1px solid #000; padding: 10px; text-align: right; font-weight: bold;">Line Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.line_ids" t-as="line">
                                            <tr>
                                                <td style="border: 1px solid #000; padding: 8px;"><t t-esc="line.item_description"/></td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;"><t t-esc="'{0:,.2f}'.format(line.quantity_ordered)"/></td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                                    <t t-if="o.currency_id"><t t-esc="o.currency_id.symbol"/></t>
                                                    <t t-esc="'{0:,.2f}'.format(line.unit_price)"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: right; font-weight: bold;">
                                                    <t t-if="o.currency_id"><t t-esc="o.currency_id.symbol"/></t>
                                                    <t t-esc="'{0:,.2f}'.format(line.line_total)"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr style="background-color: #f0f0f0;">
                                            <td colspan="3" style="border: 1px solid #000; padding: 10px; text-align: right; font-weight: bold;">Total Amount:</td>
                                            <td style="border: 1px solid #000; padding: 10px; text-align: right; font-weight: bold; font-size: 16px;">
                                                <t t-if="o.currency_id"><t t-esc="o.currency_id.symbol"/></t>
                                                <t t-esc="'{0:,.2f}'.format(o.total_po_amount)"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            
                            <!-- Footer -->
                            <div style="margin-top: 50px; text-align: center;">
                                <p style="font-size: 12px; color: #666;">Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/></p>
                            </div>
                        </div>
                    </div>
                    <div class="oe_structure"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_purchase_order" model="ir.actions.report">
        <field name="name">Purchase Order</field>
        <field name="model">logilink.purchase.order.header</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">apc_logilink.report_purchase_order_document</field>
        <field name="report_file">apc_logilink.report_purchase_order_document</field>
        <field name="print_report_name">'Purchase Order - %s' % (object.po_number)</field>
        <field name="binding_model_id" ref="model_logilink_purchase_order_header"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
