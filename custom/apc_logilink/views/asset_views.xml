<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_logilink_assets" model="ir.actions.act_window">  
        <field name="name">Asset Registry</field>
        <field name="res_model">logilink.asset</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first asset
            </p>
            <p>
                Track and manage all assets for Asia Pacific College.
                Create new asset records to register equipment, devices, and other institutional assets.
            </p>
        </field>
    </record>

    <record id="action_logilink_suppliers" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban,graph</field>
        <field name="context">{'default_is_company': True, 'default_supplier_rank': 1, 'search_default_suppliers': 1, 'res_partner_search_mode': 'supplier'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first supplier
            </p>
            <p>
                Manage suppliers and vendors for Asia Pacific College.
                Add suppliers that provide assets and equipment to the institution.
            </p>
        </field>
    </record>

    <record id="action_logilink_departments" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="res_model">logilink.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first department
            </p>
            <p>
                Manage departments for Asia Pacific College.
                Add departments that request or borrow assets.
            </p>
        </field>
    </record>

    <record id="view_logilink_asset_tree" model="ir.ui.view">
        <field name="name">logilink.asset.tree</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_code"/>
                <field name="status" widget="badge" decoration-success="status == 'working'" decoration-warning="status == 'under_maintenance' or status == 'reserved'" decoration-danger="status == 'broken' or status == 'lost'"/>
                <field name="model_no"/>
                <field name="serial_no"/>
                <field name="date"/>
                <field name="purchase_order_no"/>
                <field name="received_by_id"/>
                <field name="department_id"/>
                <field name="supplier_id"/>
                <field name="price"/>
                <field name="warranty_expiration"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logilink_asset_form" model="ir.ui.view">
        <field name="name">logilink.asset.form</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <form string="Asset Registry">
                <header>
                    <button name="action_view_transactions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list">
                        <field name="transaction_count"
                            widget="statinfo"
                            string="Transactions"/>
                    </button>
                    <button name="action_view_list_export"
                            type="object"
                            string="Export Data"
                            class="btn-primary"
                            icon="fa-download"
                            title="Open list view to export data (CSV/XLSX)"/>
                </header>

                <sheet>
                    <!-- Asset Information - 3 Columns -->
                    <group>
                        <!-- Column 1: Basic Information -->
                        <group>
                            <field name="name"/>
                            <field name="asset_code"/>
                            <field name="model_no"/>
                            <field name="serial_no"/>
                            <field name="kiosk_url" readonly="1" widget="url" placeholder="Generate QR code URL for kiosk mode"/>
                        </group>
                        <!-- Column 2: Purchase & Receipt Information -->
                        <group>
                            <field name="date"/>
                            <field name="purchase_order_no"/>
                            <field name="supplier_id"
                                options="{'no_create': True}"/>
                            <field name="price"/>
                        </group>
                        <!-- Column 3: Assignment & Status -->
                        <group>
                            <field name="department_id"
                                options="{'no_create': True}"/>
                            <field name="received_by_id"
                                options="{'no_create': False}"/>
                            <field name="status" widget="radio" options="{'horizontal': true}"/>
                            <field name="warranty_expiration"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <!-- Borrower Information Section -->
                    <group string="Borrower Information" colspan="4">
                        <group>
                            <field name="is_currently_borrowed" readonly="1"/>
                            <field name="current_borrower_id" readonly="1" invisible="not is_currently_borrowed"/>
                        </group>
                        <group>
                            <field name="last_borrower_id" readonly="1"/>
                            <field name="last_borrowed_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                    </group>

                    <!-- Description - Full Width -->
                    <group>
                        <field name="description"
                            placeholder="Enter detailed description of the asset..."/>
                    </group>

                    <!-- Hidden field for transaction count -->
                    <group>
                        <field name="transaction_count" invisible="1"/>
                    </group>

                    <!-- 🔽 FULL WIDTH TRANSACTION HISTORY -->
                    <group string="Transaction History" colspan="4">
                        <field name="borrowing_ids"
                            nolabel="1"
                            context="{'default_asset_id': id}">
                            <list editable="bottom">
                                <field name="name" string="Reference"/>
                                <field name="community_id" string="Community Member"/>
                                <field name="borrowed_date" string="Borrowed"/>
                                <field name="expected_return_date" string="Expected Return"/>
                                <field name="actual_return_date" string="Returned" optional="hide"/>
                                <field name="status" widget="badge"/>
                                <field name="notes" optional="hide"/>
                            </list>
                        </field>
                    </group>

                </sheet>
                <chatter/>
            </form>

        </field>
    </record>

    <!-- Graph View: Suppliers Analysis -->
    <record id="view_logilink_suppliers_graph" model="ir.ui.view">
        <field name="name">res.partner.suppliers.graph</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <graph string="Suppliers Analysis" type="pie" sample="1">
                <field name="category_id" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Graph View: Assets by Department -->
    <record id="view_logilink_asset_graph_department" model="ir.ui.view">
        <field name="name">logilink.asset.graph.department</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets by Department" type="bar" sample="1">
                <field name="department_id" type="row"/>
                <field name="price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Graph View: Assets by Date -->
    <record id="view_logilink_asset_graph_date" model="ir.ui.view">
        <field name="name">logilink.asset.graph.date</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets Over Time" type="line" sample="1">
                <field name="date" type="row" interval="month"/>
                <field name="price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Graph View: Assets by Supplier -->
    <record id="view_logilink_asset_graph_supplier" model="ir.ui.view">
        <field name="name">logilink.asset.graph.supplier</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets by Supplier" type="pie" sample="1">
                <field name="supplier_id" type="row"/>
                <field name="price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Default Graph View (Assets by Department) -->
    <record id="view_logilink_asset_graph" model="ir.ui.view">
        <field name="name">logilink.asset.graph</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <graph string="Asset Analysis" type="bar" sample="1">
                <field name="department_id" type="row"/>
                <field name="price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Graph View: Assets by Status -->
    <record id="view_logilink_asset_graph_status" model="ir.ui.view">
        <field name="name">logilink.asset.graph.status</field>
        <field name="model">logilink.asset</field>
        <field name="arch" type="xml">
            <graph string="Assets by Status" type="pie" sample="1">
                <field name="status" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    
</odoo>
