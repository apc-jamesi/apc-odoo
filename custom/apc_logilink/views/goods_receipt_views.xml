<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_logilink_goods_receipt" model="ir.actions.act_window">  
        <field name="name">Goods Receipt Note (GRN)</field>
        <field name="res_model">logilink.goods.receipt.header</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first goods receipt note
            </p>
            <p>
                Manage goods receipt notes for Asia Pacific College.
                Record received goods from suppliers and track their condition and acceptance.
            </p>
        </field>
    </record>

    <record id="view_logilink_goods_receipt_tree" model="ir.ui.view">
        <field name="name">logilink.goods.receipt.header.tree</field>
        <field name="model">logilink.goods.receipt.header</field>
        <field name="arch" type="xml">
            <list>
                <field name="grn_number"/>
                <field name="po_id"/>
                <field name="date_received"/>
                <field name="received_by"/>
                <field name="status" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logilink_goods_receipt_form" model="ir.ui.view">
        <field name="name">logilink.goods.receipt.header.form</field>
        <field name="model">logilink.goods.receipt.header</field>
        <field name="arch" type="xml">
            <form string="Goods Receipt Note (GRN)">
                <sheet>
                    <group>
                        <group>
                            <field name="grn_number" required="1"/>
                            <field name="po_id" options="{'no_create': True}" required="1"/>
                            <field name="date_received" required="1"/>
                            <field name="received_by" options="{'no_create': False}" required="1"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="GRN Lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="po_line_id" options="{'no_create': True}" required="1"/>
                                    <field name="quantity_received" required="1"/>
                                    <field name="quantity_accepted" required="1"/>
                                    <field name="condition" required="1"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    
</odoo>
