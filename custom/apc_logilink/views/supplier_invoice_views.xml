<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_logilink_supplier_invoice" model="ir.actions.act_window">  
        <field name="name">Supplier Invoice</field>
        <field name="res_model">logilink.supplier.invoice.header</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first supplier invoice
            </p>
            <p>
                Manage supplier invoices for Asia Pacific College.
                Record supplier invoices, match them with purchase orders, and track approval status.
            </p>
        </field>
    </record>

    <record id="view_logilink_supplier_invoice_tree" model="ir.ui.view">
        <field name="name">logilink.supplier.invoice.header.tree</field>
        <field name="model">logilink.supplier.invoice.header</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_number"/>
                <field name="supplier_id"/>
                <field name="po_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="total_invoice_amount"/>
                <field name="match_status" widget="badge"/>
                <field name="approval_status" widget="badge"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logilink_supplier_invoice_form" model="ir.ui.view">
        <field name="name">logilink.supplier.invoice.header.form</field>
        <field name="model">logilink.supplier.invoice.header</field>
        <field name="arch" type="xml">
            <form string="Supplier Invoice">
                <header>
                    <button name="action_view_list_export"
                            type="object"
                            string="Export Data"
                            class="btn-primary"
                            icon="fa-download"
                            title="Open list view to export data (CSV/XLSX)"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="invoice_number" required="1"/>
                            <field name="supplier_id" options="{'no_create': True}" required="1"/>
                            <field name="po_id" options="{'no_create': True}"/>
                            <field name="invoice_date" required="1"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="total_invoice_amount"/>
                            <field name="match_status"/>
                            <field name="approval_status"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice Lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="po_line_id"
                                           options="{'no_create': True}"
                                           domain="[('po_id', '=', parent.po_id)]"/>
                                    <field name="quantity_invoiced" required="1"/>
                                    <field name="unit_price" required="1"/>
                                    <field name="line_total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Graph View: Supplier Invoices by Supplier -->
    <record id="view_logilink_supplier_invoice_graph" model="ir.ui.view">
        <field name="name">logilink.supplier.invoice.header.graph</field>
        <field name="model">logilink.supplier.invoice.header</field>
        <field name="arch" type="xml">
            <graph string="Supplier Invoices Analysis" type="bar" sample="1">
                <field name="supplier_id" type="row"/>
                <field name="total_invoice_amount" type="measure"/>
            </graph>
        </field>
    </record>

    
</odoo>
