<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_logilink_community" model="ir.actions.act_window">
        <field name="name">Community</field>
        <field name="res_model">logilink.community</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first community member
            </p>
            <p>
                Manage community members (users/members) for Asia Pacific College.
                Add members with their ID numbers, contact information, and track their activities.
            </p>
        </field>
    </record>

    <record id="view_logilink_community_tree" model="ir.ui.view">
        <field name="name">logilink.community.tree</field>
        <field name="model">logilink.community</field>
        <field name="arch" type="xml">
            <list>
                <field name="id_number"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logilink_community_form" model="ir.ui.view">
        <field name="name">logilink.community.form</field>
        <field name="model">logilink.community</field>
        <field name="arch" type="xml">
            <form string="Community Member">
                <header>
                    <button name="action_view_list_export"
                            type="object"
                            string="Export Data"
                            class="btn-primary"
                            icon="fa-download"
                            title="Open list view to export data (CSV/XLSX)"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="id_number" required="1"/>
                            <field name="name" required="1"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Graph View: Community Analysis -->
    <record id="view_logilink_community_graph" model="ir.ui.view">
        <field name="name">logilink.community.graph</field>
        <field name="model">logilink.community</field>
        <field name="arch" type="xml">
            <graph string="Community Analysis" type="bar" sample="1">
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    
</odoo>
