<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_logilink_purchase_order" model="ir.actions.act_window">  
        <field name="name">Purchase Order</field>
        <field name="res_model">logilink.purchase.order.header</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first purchase order
            </p>
            <p>
                Manage purchase orders for Asia Pacific College.
                Create purchase orders from approved purchase requests and track their fulfillment status.
            </p>
        </field>
    </record>

    <record id="view_logilink_purchase_order_tree" model="ir.ui.view">
        <field name="name">logilink.purchase.order.header.tree</field>
        <field name="model">logilink.purchase.order.header</field>
        <field name="arch" type="xml">
            <list decoration-success="status == 'approved'"
                  decoration-warning="status in ['sent_supplier','submitted_email','printed']"
                  decoration-danger="status == 'declined'">
                <field name="po_number"/>
                <field name="pr_id"/>
                <field name="approver_id"/>
                <field name="supplier_id"/>
                <field name="po_date"/>
                <field name="status" widget="badge"/>
                <field name="total_po_amount"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_logilink_purchase_order_form" model="ir.ui.view">
        <field name="name">logilink.purchase.order.header.form</field>
        <field name="model">logilink.purchase.order.header</field>
        <field name="arch" type="xml">
            <form string="Purchase Order">
                <header>
                    <button name="action_send_purchase_order_email"
                            type="object"
                            string="Submit via Email"
                            class="oe_highlight"
                            icon="fa-envelope"
                            invisible="status != 'sent_supplier'"
                            title="Submit this Purchase Order for approval via email"/>
                    <button name="action_mark_sent_supplier"
                            type="object"
                            string="Sent to Supplier"
                            class="btn-secondary"
                            icon="fa-paper-plane"
                            invisible="status != 'requested'"
                            title="Mark this Purchase Order as sent to supplier for quotation"/>
                    <button name="action_view_list_export"
                            type="object"
                            string="Export Data"
                            class="btn-primary"
                            icon="fa-download"
                            title="Open list view to export data (CSV/XLSX)"/>
                    <button name="action_print_po"
                            type="object"
                            string="Print PDF"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"
                            invisible="status != 'sent_supplier'"
                            title="Print Purchase Order (manual approval path)"/>
                    <button name="action_print_approved_po"
                            type="object"
                            string="Print Approved PDF"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"
                            invisible="status != 'approved'"
                            title="Print the approved Purchase Order as PDF"/>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="oe_highlight"
                            icon="fa-thumbs-up"
                            invisible="status != 'printed'"
                            title="Manually approve this Purchase Order (printed path)"/>
                    <button name="action_decline"
                            type="object"
                            string="Decline"
                            class="btn-danger"
                            icon="fa-times"
                            invisible="status != 'printed'"
                            title="Manually decline this Purchase Order (printed path)"/>
                </header>
                <sheet>
                    <!-- Visual status banners -->
                    <div class="oe_title" invisible="status != 'requested'">
                        <div style="margin: 8px 0 16px 0; padding: 12px 14px; border-left: 4px solid #757575; background: #f5f5f5; color: #424242; border-radius: 4px;">
                            <strong style="color:#424242;">Status: Requested</strong> - Initial draft state.
                        </div>
                    </div>
                    <div class="oe_title" invisible="status != 'sent_supplier'">
                        <div style="margin: 8px 0 16px 0; padding: 12px 14px; border-left: 4px solid #5c6bc0; background: #e8eaf6; color: #283593; border-radius: 4px;">
                            <strong style="color:#283593;">Status: Sent to Supplier (Quotation)</strong> - Choose Submit via Email or Print PDF.
                        </div>
                    </div>
                    <div class="oe_title" invisible="status != 'submitted_email'">
                        <div style="margin: 8px 0 16px 0; padding: 12px 14px; border-left: 4px solid #1976d2; background: #e3f2fd; color: #0d47a1; border-radius: 4px;">
                            <strong style="color:#0d47a1;">Status: Submitted for Approval via Email</strong> - Waiting for approver action from email.
                        </div>
                    </div>
                    <div class="oe_title" invisible="status != 'printed'">
                        <div style="margin: 8px 0 16px 0; padding: 12px 14px; border-left: 4px solid #f9a825; background: #fff8e1; color: #8d6e63; border-radius: 4px;">
                            <strong style="color:#8d6e63;">Status: Printed</strong> - Use manual Approve/Decline buttons.
                        </div>
                    </div>
                    <div class="oe_title" invisible="status != 'approved'">
                        <div style="margin: 8px 0 16px 0; padding: 12px 14px; border-left: 4px solid #43a047; background: #e8f5e9; color: #1b5e20; border-radius: 4px;">
                            <strong style="color:#1b5e20;">Status: Approved</strong> - Closed.
                        </div>
                    </div>
                    <div class="oe_title" invisible="status != 'declined'">
                        <div style="margin: 8px 0 16px 0; padding: 12px 14px; border-left: 4px solid #f44336; background: #ffebee; color: #b71c1c; border-radius: 4px;">
                            <strong style="color:#b71c1c;">Status: Declined</strong> - Closed.
                        </div>
                    </div>
                    <!-- Status bar at the very top -->
                    <group>
                        <field name="status" widget="statusbar"
                               statusbar_visible="requested,sent_supplier,submitted_email,printed,approved,declined"/>
                    </group>
                    <group>
                        <group>
                            <field name="po_number" required="1"/>
                            <field name="pr_id" options="{'no_create': True}" domain="[('status', '=', 'approved')]"/>
                            <field name="approver_id" options="{'no_create': True}"/>
                            <field name="supplier_id" options="{'no_create': True}"/>
                            <field name="po_date" required="1"/>
                        </group>
                        <group>
                            <field name="total_po_amount"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="PO Lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="pr_line_id"
                                           options="{'no_create': True}"
                                           domain="[('pr_id', '=', parent.pr_id)]"/>
                                    <field name="pr_quantity_requested" readonly="1"/>
                                    <field name="unit_price" string="Unit Cost"/>
                                    <field name="line_total" string="Line Total" readonly="1"/>
                                    <field name="pr_item_type" readonly="1"/>
                                    <field name="pr_estimated_unit_cost" string="Requested Unit Cost" readonly="1" optional="hide"/>
                                    <field name="pr_line_total" string="Requested Line Total" readonly="1" optional="hide"/>
                                    <field name="pr_line_summary" readonly="1" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Graph View: Purchase Orders by Supplier -->
    <record id="view_logilink_purchase_order_graph" model="ir.ui.view">
        <field name="name">logilink.purchase.order.header.graph</field>
        <field name="model">logilink.purchase.order.header</field>
        <field name="arch" type="xml">
            <graph string="Purchase Orders Analysis" type="bar" sample="1">
                <field name="supplier_id" type="row"/>
                <field name="total_po_amount" type="measure"/>
            </graph>
        </field>
    </record>

    
</odoo>
